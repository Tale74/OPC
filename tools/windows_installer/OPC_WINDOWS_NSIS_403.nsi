Unicode true
!include "MUI2.nsh"
!ifndef OPC_VERSION
!define OPC_VERSION "4.0.3"
!endif
!ifndef OPC_INSTALL_REG_KEY
!define OPC_INSTALL_REG_KEY "Software\OPC\Install"
!endif
!ifndef OPC_UNINSTALL_REG_KEY
!define OPC_UNINSTALL_REG_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\OPC_PerUser"
!endif
!ifndef OPC_OUTPUT_SUFFIX
!define OPC_OUTPUT_SUFFIX ""
!endif
Name "OPC ${OPC_VERSION}"
OutFile "output\OPC_Setup_${OPC_VERSION}_PerUser${OPC_OUTPUT_SUFFIX}.exe"
InstallDir "$LOCALAPPDATA\Programs\OPC"
InstallDirRegKey HKCU "${OPC_INSTALL_REG_KEY}" "Path"
RequestExecutionLevel user
SetCompressor /SOLID lzma
Icon "OPC.ico"
UninstallIcon "OPC.ico"
!define MUI_ABORTWARNING
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"
Section "Install" SEC01
SetShellVarContext current
SetOutPath "$INSTDIR"
File "build_input\dartjni.dll"
SetOutPath "$INSTDIR\data"
File "build_input\data\app.so"
SetOutPath "$INSTDIR\data\flutter_assets"
File "build_input\data\flutter_assets\AssetManifest.bin"
SetOutPath "$INSTDIR\data\flutter_assets\assets\fonts"
File "build_input\data\flutter_assets\assets\fonts\NotoSans-Bold.ttf"
SetOutPath "$INSTDIR\data\flutter_assets\assets\fonts"
File "build_input\data\flutter_assets\assets\fonts\NotoSans-BoldItalic.ttf"
SetOutPath "$INSTDIR\data\flutter_assets\assets\fonts"
File "build_input\data\flutter_assets\assets\fonts\NotoSans-Italic.ttf"
SetOutPath "$INSTDIR\data\flutter_assets\assets\fonts"
File "build_input\data\flutter_assets\assets\fonts\NotoSans-Regular.ttf"
SetOutPath "$INSTDIR\data\flutter_assets\assets\fonts"
File "build_input\data\flutter_assets\assets\fonts\NotoSerif-Variable.ttf"
SetOutPath "$INSTDIR\data\flutter_assets\assets"
File "build_input\data\flutter_assets\assets\opc_user_guide.json"
SetOutPath "$INSTDIR\data\flutter_assets\assets"
File "build_input\data\flutter_assets\assets\scenario_defaults.json"
SetOutPath "$INSTDIR\data\flutter_assets\assets\simboli"
File "build_input\data\flutter_assets\assets\simboli\_simboli_strip.png"
SetOutPath "$INSTDIR\data\flutter_assets\assets\simboli"
File "build_input\data\flutter_assets\assets\simboli\DavidStar.png"
SetOutPath "$INSTDIR\data\flutter_assets\assets\simboli"
File "build_input\data\flutter_assets\assets\simboli\parte_davidova_zvezda.png"
SetOutPath "$INSTDIR\data\flutter_assets\assets\simboli"
File "build_input\data\flutter_assets\assets\simboli\parte_katolicki_krst.png"
SetOutPath "$INSTDIR\data\flutter_assets\assets\simboli"
File "build_input\data\flutter_assets\assets\simboli\parte_obican_krst.png"
SetOutPath "$INSTDIR\data\flutter_assets\assets\simboli"
File "build_input\data\flutter_assets\assets\simboli\parte_petokraka.png"
SetOutPath "$INSTDIR\data\flutter_assets\assets\simboli"
File "build_input\data\flutter_assets\assets\simboli\parte_polumesec.png"
SetOutPath "$INSTDIR\data\flutter_assets\assets\simboli"
File "build_input\data\flutter_assets\assets\simboli\Svetosavski.png"
SetOutPath "$INSTDIR\data\flutter_assets"
File "build_input\data\flutter_assets\FontManifest.json"
SetOutPath "$INSTDIR\data\flutter_assets\fonts"
File "build_input\data\flutter_assets\fonts\MaterialIcons-Regular.otf"
SetOutPath "$INSTDIR\data\flutter_assets"
File "build_input\data\flutter_assets\NativeAssetsManifest.json"
SetOutPath "$INSTDIR\data\flutter_assets"
File "build_input\data\flutter_assets\NOTICES.Z"
SetOutPath "$INSTDIR\data\flutter_assets\packages\flutter_local_notifications_web\web"
File "build_input\data\flutter_assets\packages\flutter_local_notifications_web\web\notifications_service_worker.js"
SetOutPath "$INSTDIR\data\flutter_assets\shaders"
File "build_input\data\flutter_assets\shaders\ink_sparkle.frag"
SetOutPath "$INSTDIR\data\flutter_assets\shaders"
File "build_input\data\flutter_assets\shaders\stretch_effect.frag"
SetOutPath "$INSTDIR\data"
File "build_input\data\icudtl.dat"
SetOutPath "$INSTDIR"
File "build_input\file_selector_windows_plugin.dll"
SetOutPath "$INSTDIR"
File "build_input\flutter_local_notifications_windows.dll"
SetOutPath "$INSTDIR"
File "build_input\flutter_timezone_plugin.dll"
SetOutPath "$INSTDIR"
File "build_input\flutter_windows.dll"
SetOutPath "$INSTDIR"
File "build_input\native_assets.json"
SetOutPath "$INSTDIR"
File "build_input\OPC.exe"
SetOutPath "$INSTDIR"
File "build_input\pdfium.dll"
SetOutPath "$INSTDIR"
File "build_input\printing_plugin.dll"
SetOutPath "$INSTDIR"
File "build_input\screen_retriever_windows_plugin.dll"
SetOutPath "$INSTDIR"
File "build_input\share_plus_plugin.dll"
SetOutPath "$INSTDIR"
File "build_input\sqlite3.dll"
SetOutPath "$INSTDIR"
File "build_input\url_launcher_windows_plugin.dll"
SetOutPath "$INSTDIR"
File "build_input\window_manager_plugin.dll"
WriteUninstaller "$INSTDIR\Uninstall.exe"
CreateDirectory "$SMPROGRAMS\OPC"
CreateShortCut "$SMPROGRAMS\OPC\OPC.lnk" "$INSTDIR\OPC.exe"
CreateShortCut "$DESKTOP\OPC.lnk" "$INSTDIR\OPC.exe" "" "$INSTDIR\OPC.exe" 0 SW_SHOWNORMAL "" "OPC"
WriteRegStr HKCU "${OPC_INSTALL_REG_KEY}" "Path" "$INSTDIR"
WriteRegStr HKCU "${OPC_UNINSTALL_REG_KEY}" "DisplayName" "OPC ${OPC_VERSION}"
WriteRegStr HKCU "${OPC_UNINSTALL_REG_KEY}" "DisplayVersion" "${OPC_VERSION}"
WriteRegStr HKCU "${OPC_UNINSTALL_REG_KEY}" "UninstallString" "$\"$INSTDIR\Uninstall.exe$\""
SectionEnd
Section "Uninstall"
SetShellVarContext current
Delete "$SMPROGRAMS\OPC\OPC.lnk"
Delete "$DESKTOP\OPC.lnk"
RMDir "$SMPROGRAMS\OPC"
Delete "$INSTDIR\dartjni.dll"
Delete "$INSTDIR\data\app.so"
Delete "$INSTDIR\data\flutter_assets\AssetManifest.bin"
Delete "$INSTDIR\data\flutter_assets\assets\fonts\NotoSans-Bold.ttf"
Delete "$INSTDIR\data\flutter_assets\assets\fonts\NotoSans-BoldItalic.ttf"
Delete "$INSTDIR\data\flutter_assets\assets\fonts\NotoSans-Italic.ttf"
Delete "$INSTDIR\data\flutter_assets\assets\fonts\NotoSans-Regular.ttf"
Delete "$INSTDIR\data\flutter_assets\assets\fonts\NotoSerif-Variable.ttf"
Delete "$INSTDIR\data\flutter_assets\assets\opc_user_guide.json"
Delete "$INSTDIR\data\flutter_assets\assets\scenario_defaults.json"
Delete "$INSTDIR\data\flutter_assets\assets\simboli\_simboli_strip.png"
Delete "$INSTDIR\data\flutter_assets\assets\simboli\DavidStar.png"
Delete "$INSTDIR\data\flutter_assets\assets\simboli\parte_davidova_zvezda.png"
Delete "$INSTDIR\data\flutter_assets\assets\simboli\parte_katolicki_krst.png"
Delete "$INSTDIR\data\flutter_assets\assets\simboli\parte_obican_krst.png"
Delete "$INSTDIR\data\flutter_assets\assets\simboli\parte_petokraka.png"
Delete "$INSTDIR\data\flutter_assets\assets\simboli\parte_polumesec.png"
Delete "$INSTDIR\data\flutter_assets\assets\simboli\Svetosavski.png"
Delete "$INSTDIR\data\flutter_assets\FontManifest.json"
Delete "$INSTDIR\data\flutter_assets\fonts\MaterialIcons-Regular.otf"
Delete "$INSTDIR\data\flutter_assets\NativeAssetsManifest.json"
Delete "$INSTDIR\data\flutter_assets\NOTICES.Z"
Delete "$INSTDIR\data\flutter_assets\packages\flutter_local_notifications_web\web\notifications_service_worker.js"
Delete "$INSTDIR\data\flutter_assets\shaders\ink_sparkle.frag"
Delete "$INSTDIR\data\flutter_assets\shaders\stretch_effect.frag"
Delete "$INSTDIR\data\icudtl.dat"
Delete "$INSTDIR\file_selector_windows_plugin.dll"
Delete "$INSTDIR\flutter_local_notifications_windows.dll"
Delete "$INSTDIR\flutter_timezone_plugin.dll"
Delete "$INSTDIR\flutter_windows.dll"
Delete "$INSTDIR\native_assets.json"
Delete "$INSTDIR\OPC.exe"
Delete "$INSTDIR\pdfium.dll"
Delete "$INSTDIR\printing_plugin.dll"
Delete "$INSTDIR\screen_retriever_windows_plugin.dll"
Delete "$INSTDIR\share_plus_plugin.dll"
Delete "$INSTDIR\sqlite3.dll"
Delete "$INSTDIR\url_launcher_windows_plugin.dll"
Delete "$INSTDIR\window_manager_plugin.dll"
RMDir "$INSTDIR\data\flutter_assets\packages\flutter_local_notifications_web\web"
RMDir "$INSTDIR\data\flutter_assets\packages\flutter_local_notifications_web"
RMDir "$INSTDIR\data\flutter_assets\assets\simboli"
RMDir "$INSTDIR\data\flutter_assets\assets\fonts"
RMDir "$INSTDIR\data\flutter_assets\packages"
RMDir "$INSTDIR\data\flutter_assets\shaders"
RMDir "$INSTDIR\data\flutter_assets\assets"
RMDir "$INSTDIR\data\flutter_assets\fonts"
RMDir "$INSTDIR\data\flutter_assets"
RMDir "$INSTDIR\data"
Delete "$INSTDIR\Uninstall.exe"
RMDir "$INSTDIR"
DeleteRegKey HKCU "${OPC_UNINSTALL_REG_KEY}"
DeleteRegKey HKCU "${OPC_INSTALL_REG_KEY}"
SectionEnd
